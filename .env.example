# Copy this file to .env.local (never committed) and fill in the values.
# On Vercel, add the same variables in Project Settings > Environment Variables.

# Admins of the future hidden dashboard: comma-separated SHA-256 hashes of lower-case emails.
# Make a hash with:  printf '%s' 'you@example.com' | sha256sum
# Only the hash is stored, so the email itself never appears in the code or the published site.
VITE_ADMIN_EMAIL_SHA256=
