{
  "name": "viralforge",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test \"tests/*.test.js\"",
    "lint": "eslint .",
    "check": "eslint . && node --test \"tests/*.test.js\" && vite build",
    "screenshots": "electron scripts/screenshots.cjs",
    "desktop": "vite build && electron .",
    "dist": "vite build && electron-builder --win --publish never",
    "brand": "node scripts/apply-brand.cjs",
    "icons": "electron scripts/make-icons.cjs && npx --yes @capacitor/assets@3 generate --iconBackgroundColor \"#0b0d12\" --iconBackgroundColorDark \"#0b0d12\" --splashBackgroundColor \"#0b0d12\" --splashBackgroundColorDark \"#0b0d12\"",
    "mobile:sync": "vite build && cap sync",
    "android": "vite build && cap sync android && cap open android",
    "ios": "vite build && cap sync ios && cap open ios"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@eslint/js": "^9.39.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "lucide-react": "^0.469.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.5"
  },
  "main": "electron/main.cjs",
  "description": "ViralForge (فايرال فورج) - creator studio for YouTube, Shorts and live streams: titles, descriptions, thumbnails and a thumbnail evaluator",
  "license": "MIT",
  "build": {
    "appId": "com.viralforge.app",
    "productName": "ViralForge",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "shared/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "signtoolOptions": {
        "signingHashAlgorithms": [
          "sha256"
        ]
      },
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "ViralForge",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "copyright": "© 2026 ViralForge contributors",
    "publish": [
      {
        "provider": "github",
        "owner": "m7md0xp-boop",
        "repo": "viralforge",
        "releaseType": "release"
      }
    ],
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    }
  },
  "author": {
    "name": "ViralForge contributors"
  },
  "homepage": "https://github.com/m7md0xp-boop/viralforge",
  "repository": {
    "type": "git",
    "url": "https://github.com/m7md0xp-boop/viralforge.git"
  }
}
